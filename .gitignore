# Claude / agent tooling
CLAUDE.md
.claude/
.serena/
.mcp.json

# Source installer (large binary, fetch from EPA)
installer/*.exe
installer/*.zip

# Throwaway / one-shot scripts (committed scripts live in scripts/ and
# app/scripts/; ad-hoc repros go under scripts/_oneoff/ and stay local).
scripts/_oneoff/
app/scripts/_oneoff/

# Raw extracted installer payload (regenerable from installer)
extracted/

# Ghidra project (large, machine-specific, regenerable)
decompilation/ghidra-project/

# Generated SQLite DBs (regenerable from CSVs via scripts/dump-mdb.py)
mdb/*/*.sqlite
mdb/*/schema.sql

# Decompiled help HTML (regenerable from .chm)
help/html/

# Raw strings dumps (regenerable)
strings/ascii.txt
strings/unicode.txt
strings/pe-imports.txt

# OS / editor cruft
.DS_Store
*.swp
*~
__pycache__/
*.pyc
.venv/
venv/
