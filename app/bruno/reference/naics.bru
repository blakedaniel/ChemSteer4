meta {
  name: NAICS search
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/reference/naics?q=325
}

assert {
  res.status: eq 200
}

script:post-response {
  const rows = res.getBody();
  if (!rows.some(r => r.description && r.description.includes("Chemical"))) {
    throw new Error("expected Chemical Manufacturing in NAICS 325 results");
  }
}
